# Required: public GitHub repository URL (HTTPS recommended with token)
REPO_URL=https://github.com/khannover/bancamp-asylum-wall.git

# Required for HTTPS push: GitHub Personal Access Token with repo scope
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Optional
GIT_BRANCH=main
GIT_USER_NAME=Asylum Wall Bot
GIT_USER_EMAIL=asylum-wall@bancamp.de
PORT=8080

# Anti-spam rate limits for quick signals
SIGNAL_MAX_PER_HOUR=5
SIGNAL_MAX_PER_DAY=20
SIGNAL_DUPLICATE_HOURS=24

# Optional: enable ledger entry editing (PATCH /api/cases/{id})
# Requires X-Edit-Token header; each edit becomes a Git commit
EDIT_TOKEN=change-me-to-a-long-random-secret